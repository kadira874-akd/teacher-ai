*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/
.eggs/
*.egg-info/
.venv/
venv/
env/
ENV/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.*
!.env.example

# Coverage reports
coverage/
*.gcov
*.lcov

# Compiled Binary files
*.exe
*.dll
*.so
*.dylib
*.o
*.a
*.obj
*.out

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z
