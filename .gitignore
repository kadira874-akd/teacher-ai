```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
.next/

# Environment variables
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Coverage reports
coverage/
htmlcov/

# OS generated files
.DS_Store
Thumbs.db

# Local configuration
*.local

# Cache directories
.cache/
.mypy_cache/
.pytest_cache/
.nyc_output/
coverage/

# Compiled binary files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.a
*.obj
*.out
```